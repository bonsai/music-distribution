{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bonsai/music-distribution/blob/main/schema/distributors.schema.json",
  "title": "Music Distributor Knowledge Base",
  "type": "object",
  "required": ["schema_version", "as_of", "distributors", "evidence"],
  "properties": {
    "schema_version": {"type": "string"},
    "as_of": {"type": "string", "format": "date"},
    "distributors": {"type": "array", "items": {"$ref": "#/$defs/distributor"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "money": {
      "type": "object",
      "required": ["amount", "currency", "period", "basis"],
      "properties": {
        "amount": {"type": "number"},
        "currency": {"type": "string"},
        "period": {"type": "string"},
        "basis": {"type": "string"}
      }
    },
    "distributor": {
      "type": "object",
      "required": ["id", "name", "official_url", "pricing", "revenue", "distribution", "features", "evidence_ids"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "owner_or_affiliation": {"type": "string"},
        "official_url": {"type": "string", "format": "uri"},
        "pricing": {"type": "array", "items": {"type": "object"}},
        "revenue": {"type": "object"},
        "distribution": {"type": "object"},
        "features": {"type": "object"},
        "best_for": {"type": "array", "items": {"type": "string"}},
        "cautions": {"type": "array", "items": {"type": "string"}},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["id", "distributor_id", "claim", "source_url", "source_type", "checked_at"],
      "properties": {
        "id": {"type": "string"},
        "distributor_id": {"type": "string"},
        "claim": {"type": "string"},
        "source_url": {"type": "string", "format": "uri"},
        "source_type": {"enum": ["official_pricing", "official_product", "official_support", "official_terms"]},
        "checked_at": {"type": "string", "format": "date"},
        "quote": {"type": "string"},
        "confidence": {"enum": ["high", "medium", "low"]}
      }
    }
  }
}
